<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="6">

  <DocumentRef DateTime="20261007T223027" id="0615a95f-288c-4115-b6f7-35bfd09bb32a">
    <XRef DateTime="20261007T222744" id="c435a5e4-d7c2-4d98-a28a-de2ee2f7c6d5"/>
  </DocumentRef>

  <Content>
    <Paragraph Type="Scene Info" id="71950a52-c9be-4669-a6f0-bbb7a760d2ca">
      <Text Style="Bold+Underline+AllCaps">Scene 1</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="987c3cbc-adb0-4eed-895f-9c2ec73d05c3">
      <SceneProperties Length="1/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Ext. The Southeast - NO Man’s Land - Day (50 Years Ago)</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="93d78288-cd47-42a1-bc05-4a7a4a908f37">
      <SceneProperties Length="2 5/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="JESSICA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="JESSICA &amp; LORENZA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="LORENZA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline+AllCaps">1. “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Nothing Lasts</Text>
      <Text Style="Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1c1f6585-9200-449a-8dd3-afce3b21a7c6">
      <Text>In the peaceful region known as The Southeast, the </Text>
      <Text Style="AllCaps">Legato Sisters - Jessica (</Text>
      <Text>24, a musician with a guitar</Text>
      <Text Style="AllCaps">) </Text>
      <Text>and </Text>
      <Text Style="AllCaps">Lorenza</Text>
      <Text> (20, a songwriter with a book) - dash in.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="ce773b28-ac2b-4720-9b05-7b09119e0649">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="7b381cf5-6334-45bc-83d8-d4ac4aed8158">
          <Text>Jessica</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="f2d2ea6d-d30e-4e9e-bd30-035962aef10c">
          <Text>Last one to the top is...
Uh...</Text>
        </Paragraph>
        <Paragraph Type="Character" id="74596edf-3b0a-411c-a645-60dae77421f2">
          <Text>Lorenza</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="361616e3-0e65-4b7b-9547-961e50201eec">
          <Text>Last one to the bottom is a
loser!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action" id="f14b1d53-c692-4630-b7c2-d54439ce80a6">
      <Text>Jessica and Lorenza stop and set the stage.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="be1e91c9-58d3-4280-9e6b-0df6c8a66e97">
      <Text>Lorenza</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="5fcc560b-ab4c-461f-b641-03bab5b011d9">
      <Text>You’re fast, but you ain’t that bright, Jessica.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="08720240-52bc-4d61-a42a-e28b057d26f0">
      <Text>JESSICA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="b90f8c78-85dc-4b79-8e9e-21dc8d5046eb">
      <Text>You’re the slowpoke, Lorenza.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6ca78189-caaf-4223-ad36-3022e15cfef0">
      <Text>Lorenza pokes Jessica.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b6acae75-e2f5-490d-ad71-ecab553a6954">
      <Text>LoRENZA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="0374d1ae-883f-4714-8416-92250996a78a">
      <Text>Poke, poke!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="39a7011e-715e-4eee-9c95-236a75398bcd">
      <Text>Jessica pokes Lorenza back.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b28151e8-2bac-4faa-9a8b-7919fd9c351a">
      <Text>JESSICA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="8ce0167d-f19d-4c25-856a-87841a95781b">
      <Text>Lightning speed.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="523cc6e6-4106-473c-88aa-d58a4d376b0f">
      <Text>A </Text>
      <Text Style="AllCaps">boom</Text>
      <Text> thunders in the distance. Tremors are felt.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="065250be-491f-450b-b27e-49de192c4155">
      <Text>Jessica</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="d4e737e1-1e52-497d-9d7b-e5551eb07732">
      <Text>Usually lightning comes...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="577192d7-39f2-4967-a3ea-08b40c036a1d">
      <Text>LoRENZA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="7918c348-a1a7-482b-9098-c3ad5f1c9b9c">
      <Text>...before thunder.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3f477176-ddfb-48f5-95cd-eba9e6c6bb35">
      <Text>The atmosphere grows frighteningly bright.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9b449ead-01b4-4f1c-b6ba-12a6d99bb7fc">
      <Text>JessICA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="a5b1f63c-a293-49ae-ace4-2401db71ead8">
      <Text>First light...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d55a11a6-e778-4318-9bf1-9cb38cb4bbe4">
      <Text>LORENZA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="8f3aa49f-379a-4ba7-86db-2beeb8a09310">
      <Text>...then sound.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b144eede-cd61-48c8-9c68-c364a0ea9e64">
      <Text>Suddenly, everything goes dark.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8ea6ea32-e35e-4192-b8cd-b00965783a7b">
      <Text>JESSICA &amp; LORENZA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="989b52b8-d571-4649-94b1-5b3eb53dc1b0">
      <Text>But darkness is faster. War is here!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0717f966-628c-4783-9866-15876959dd82">
      <Text>Swordfights or gunfire drown out all tones of nature.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="64473588-71d6-4ca4-b9da-c5cf3d6146b0">
      <Text>LoreNZA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="b874a655-c02f-41c9-b1af-51080e815d74">
      <Text>Last one off this land will die!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="eb99c2a3-c8f2-4f0b-a5ac-54c09ce22b13">
      <Text>JessICA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c58fc154-1324-47ac-8ce8-e291f84a4288">
      <Text>Last one to abandon home will survive!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="20f3a719-2756-45a2-9157-acbeee802da7">
      <Text>JesSICA &amp; LORENZA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="8a9f63ce-b9fa-4879-a6f2-0cd99ef26130">
      <Text>Sister, this is not about you.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cfe674f3-0eb3-48a4-a482-0e875c7b6210">
      <Text>LoRENZA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="9a206f94-7dae-4efa-b60c-c332aaa0b11e">
      <Text>Get it through your head.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8938c0fb-b9d7-49ca-9bed-2b0206277902">
      <Text>The droning of drones are audible.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="634832a5-be5f-404d-b177-7c91d415bc3e">
      <Text>JessICA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="3eb579e2-2423-408b-90e3-772b4c5e4ba3">
      <Text>Look into your heart.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3555fedc-f260-4a41-8900-fc8358e18190">
      <Text>The percussion grows explosive.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="92480871-7a3e-4857-adb5-1deadd27ba5b">
      <Text>LoreNZA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c4325819-2c3f-4bf9-9ddd-16f41ae1fc2a">
      <Text>Nothing lasts...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="45502c1c-b64d-4f13-8019-187769b55d18">
      <Text>JesSICA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="95bb05ba-5a31-4e23-85d2-d45cc4c571fe">
      <Text>I’m trying my best!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7612ed75-aaf6-498c-8a83-073d559d6671">
      <Text>LoreNZA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="63d553d9-b16b-45f5-a72b-d82ec7129c4d">
      <Text>THe battalion is dynamic.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4af450a7-dac6-4e39-9515-97ed198e615f">
      <Text>JesSICA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="2623f275-15d9-4108-b717-e352a13532f7">
      <Text>We are louder.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="445e7d2c-3e5c-4f0e-9948-ae5ee848d2db">
      <Text>LoRENZA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="cc4d7642-be00-4501-86e3-b14867d2c399">
      <Text>They march moderato.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cbc9e948-58ed-48fd-a75f-03d8f12637ba">
      <Text>JesSICA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="f1701f81-fa88-4367-b358-fba4fe2e6cef">
      <Text>We outpace them, allegro.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5530509c-e7a3-4b37-af65-9f0d5d163ee1">
      <Text>LoRENZA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="b55508b7-9ea5-4326-bf9c-e39c0682801d">
      <Text>Presto!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3155c1ee-4add-47fb-8a16-7d30a640f82f">
      <Text>JESSICA &amp; LORENZA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="e33dde3a-3ce6-4084-9045-44ec5f99567b">
      <Text>Sister. This is not about the band.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f0930018-7bd0-4165-aae2-240d9db87f27">
      <Text>LorenZA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="84fd000d-c1e8-48b1-867e-054ee1a0de57">
      <Text>Nothing lasts.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="aa3ef548-d008-4459-a6d1-7f85e5786a4a">
      <Text>JessICA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="a68b663b-35d8-4b25-8886-592200ef9c6e">
      <Text>Let’s try our best.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="185f69b6-58b1-4273-a28c-0ae4b253eaa7">
      <Text>LorenZA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="744c4211-588b-45ea-8f8d-f7a123f3beb8">
      <Text>Last chorus.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a6de7634-8419-4133-ad95-019c9f120f21">
      <Text>JessICA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="3a9eb65e-7577-453a-a307-0c548bb044ba">
      <Text>Let’s focus.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="50cb3c3f-3da1-4fa7-a8fb-e8e76d89fe37">
      <Text>LORENZA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="d4c9a137-edc1-41f8-a4e8-d1fc9f50b2b4">
      <Text>How about you first for a change?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3e2096fe-ed21-4961-9ad8-6c6cfbb6e39e">
      <Text>JessICA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="fb49fe63-c80e-497b-83e2-a12aa9c157b6">
      <Text>You are always last on my mind...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6999fb6d-9023-4ad5-afdb-387ec424c540">
      <Text>Boom! The explosion splits them.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c432599e-b998-4139-a314-86d4a2090df9">
      <Text>Lorenza vanishes.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0269b1e2-5565-43c8-8fb2-1d53387f9b16">
      <Text>JeSSICA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="58a1e9b2-3be5-4990-9b25-8d93afe57a4e">
      <Text>...but you will last forever in my soul! Sister...?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="dca5d421-09af-4825-bd91-ec9957b9a4b3">
      <Text>Jessica looks around, unable to find Lorenza.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8b460510-5e0a-41b7-b740-adb60383589f">
      <Text>JessICA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="88636e35-ad6d-4752-b111-4f564e71c229">
      <Text>I will find you,
even if it’s the last thing I do.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0294a024-e5ef-4343-8d44-1ab63966e89f">
      <Text>LoRENZA (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="645d3531-d411-4ef3-a794-11f4378f05c7">
      <Text>Nothing lasts...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="da3a1f8c-8aed-47a3-8440-963eafd5484a">
      <Text>JessICA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="1fd41221-f51c-43c9-b0cc-e6f2aeab8abd">
      <Text>I’ll try my best!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="78f19fe9-2664-4113-aeab-0ec94f9850d9">
      <Text>Jessica continues to search in no man’s land.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="238fcebc-fec6-40be-93f0-bd789fcd8499">
      <Text Style="Underline">End of “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Nothing Lasts</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="abbce24d-e9f3-443c-a9de-cbafe28680ef">
      <Text Style="Bold+Underline+AllCaps">Scene 2</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="9682fb2b-ae6a-4749-96f9-a369662f3fda">
      <SceneProperties Length="1/8" Page="3" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Ext. The Midwest - Day (Present, 50 Years Later)</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="76bbb514-e185-421f-ae54-f5cced7d3e2d">
      <SceneProperties Length="6/8" Page="3" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DAKOTA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline+AllCaps">2. “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Sunrise</Text>
      <Text Style="Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c5ce47a0-cafa-4804-a327-3b95eddf8e15">
      <Text>In the urban sprawl of The Midwest, a lonely musician named Dakota (29) paces in.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a9bf1786-8e48-4234-9c8a-0f5902e8a5f4">
      <Text>Dakota</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="11f58bfe-0d5f-4e2a-b76f-777724ff5171">
      <Text>First thing in the morning
Every morning
Let out no cry
Mourn, Mourn, Mourning</Text>
    </Paragraph>
    <Paragraph Type="Action" id="abf83b92-e428-4a1e-87d2-3f36ff3528a2">
      <Text>[To be written]</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cbb933da-9401-4f3f-8ee9-5f79f7f50955">
      <Text>Dakota</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="4b305d37-03e1-4398-b49e-ca40f6e672b5">
      <Text>Sunrise
east to west
not the best in the midwest</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ba45b4b3-7f69-4882-8542-74c50f7435fb">
      <Text>[To be written]</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3ab7a132-0b80-4738-8f57-1264137664ec">
      <Text>Dakota reads the text messages.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c27a53db-761d-4911-ab9d-8e4547f30dc0">
      <Text>Dakota</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="bb174e77-5f98-4cb6-82e2-b2481de07509">
      <Text>Son, rise...
for grandma has fallen ill.
We never thought to ask:
go visit the Southeast
on our behalf.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="676a9fe6-3737-418d-9cd4-233f803b4723">
      <Text>[To be written]</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="c55d2c78-7c1c-4fb1-84b9-3d1e33d4c62c">
      <Text Style="Underline">End of “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Sunrise</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2926b310-5691-46cd-acff-65c3919176b8">
      <Text>[To be written]</Text>
    </Paragraph>
    <Paragraph Type="Character" id="56fa5ffb-4524-480f-b05e-4e1334030787">
      <Text>Dakota</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b35e3249-c98d-4767-932a-f541136cbac9">
      <Text>I’ll rise to the occasion. But nothing can top grandma...</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="7c7311fa-d309-4e89-9997-f96ff4114c21">
      <Text Style="Bold+Underline+AllCaps">Scene 3</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="e24ba0fb-1ec6-482a-8167-0db5a5f9dba3">
      <SceneProperties Length="1/8" Page="4" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Ext. The Northeast - Stage - Day (50 Years Ago)</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4ef8519b-924a-4822-89f3-f7dd84de20d7">
      <Text>In the contentious Northeast, Jessica sits alone as Lorenza peeps in.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="80834e34-aa71-4df2-8a26-f02a15384623">
      <SceneProperties Length="3/8" Page="4" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="JESSICA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="LORENZA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline+AllCaps">3. “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">The Moon Set</Text>
      <Text Style="Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6004d4bd-ea09-4922-861e-1e50ff76af58">
      <Text>LorenZA</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="8b7d1901-e995-4aff-b264-09cd4d4be147">
      <Text>Jessica!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="010504de-a917-4d10-bebd-6611bffae007">
      <Text>Jessica does not bat an eye.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="486b78e3-878a-40d0-9113-d5045b54bae5">
      <Text>Lorenza pulls out the Moon guitar, Jessica’s prized instrument. She plays the Legato Sister’s melody, out of tune.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b8df2f03-9dc5-4ffd-8b6c-bc889a172632">
      <Text>Jessica nabs the guitar and plays the melody correctly.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5550becb-cd0f-4889-832d-b7ed6f3a786f">
      <Text>Jessica</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="85440c49-2473-4a1f-baaa-de1fcb7ac7f9">
      <Text>If you’re gonna play the moon, play her fully.
You fixed her...
My Moon guitar...</Text>
    </Paragraph>
  </Content>

